{
  "name": "gridkit-layout",
  "version": "0.1.0",
  "description": "Drag, resize, reorder layout engine. No dependencies. Framework-agnostic. 10KB gzipped.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.mjs",
      "require": "./dist/vue.cjs"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.mjs",
      "require": "./dist/headless.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/react.ts src/vue.ts src/headless.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/react.ts src/vue.ts src/headless.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "grid",
    "layout",
    "drag-and-drop",
    "resize",
    "dashboard",
    "widgets",
    "collision-detection",
    "responsive",
    "framework-agnostic",
    "typescript",
    "react",
    "vue",
    "ssr",
    "headless"
  ],
  "author": "Satyamtechy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Satyamtechy/gridkit"
  },
  "homepage": "https://gridkit-layout.vercel.app",
  "bugs": {
    "url": "https://github.com/Satyamtechy/gridkit/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^29.1.1",
    "tsup": "^8.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  }
}
